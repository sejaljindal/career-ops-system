    "india-infra": "node run-daily.mjs --sector=\"Infrastructure / Capital Projects\" --max=100",
    "india-tech": "node run-daily.mjs --sector=\"Global Tech\" --max=100",
    "india-finance": "node run-daily.mjs --sector=\"Financial Services / GCC\" --max=100",
    "india-gcc": "node run-daily.mjs --sector=\"Global Capability Centre\" --max=100",
    "india-startups": "node run-daily.mjs --sector=\"Startups / Unicorns\" --max=100",
    "india-top": "node run-daily.mjs --tier=0 --max=100",
    "company:funded": "node company-funded.mjs",
    "validate:portals": "node validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
